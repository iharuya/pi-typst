{
  "name": "pi-typst",
  "version": "0.0.5",
  "description": "Pi extension that renders Typst into terminal images",
  "keywords": [
    "pi-package",
    "typst"
  ],
  "author": "iharuya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iharuya/pi-typst.git"
  },
  "homepage": "https://github.com/iharuya/pi-typst#readme",
  "bugs": {
    "url": "https://github.com/iharuya/pi-typst/issues"
  },
  "files": [
    "extensions",
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "image": "assets/demo.gif",
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm deordinal check && pnpm biome ci --diagnostic-level=warn --error-on-warnings && pnpm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests",
    "fix": "biome check --write --diagnostic-level=info --error-on-warnings",
    "fix:unsafe": "biome check --write --unsafe --verbose --error-on-warnings && deordinal check --write --unsafe"
  },
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^26.6.4",
    "deordinal": "^0.2.5",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
